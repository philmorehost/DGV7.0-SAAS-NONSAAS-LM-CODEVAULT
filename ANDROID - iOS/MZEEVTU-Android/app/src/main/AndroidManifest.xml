<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The VoveID / FaceTec KYC SDKs declare these as REQUIRED in their own manifests, so Play hid
         the app from every device without a camera and autofocus. Face capture is one feature of the
         app, not a prerequisite for installing it, and the CAMERA permission is still requested at
         runtime.
         tools:node="replace" is required, not decoration: the manifest merger ORs the `required`
         attribute, so a plain required="false" declaration here merges with the SDKs' "true" and
         still comes out required=true. `replace` drops the SDK declarations instead of merging. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" tools:node="replace" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" tools:node="replace" />

    <application
        android:name=".DGApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DGV6"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Splash (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.DGV6.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Auth -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.DGV6.NoActionBar" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.DGV6.NoActionBar" />

        <!-- Main host -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DGV6.NoActionBar" />

        <!-- Idle re-authentication gate (see DGApp) — singleTask so it can't stack duplicates -->
        <activity
            android:name=".ui.security.LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DGV6.NoActionBar" />

        <!-- FileProvider for sharing receipt images / PDFs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <!-- Firebase Cloud Messaging: handles app_update push notifications -->
        <service
            android:name=".service.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
